* { box-sizing: border-box; }

body {
    margin: 0;
    min-height: 100vh;
    font-family: Arial, sans-serif;
    background-color: #eaf3ff;
    color: #1e293b;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 20px;
}

.container {
    width: 100%;
    max-width: 480px;
    padding: 30px;
    background-color: white;
    border-radius: 16px;
    box-shadow: 0 6px 25px rgba(30, 64, 175, 0.15);
}

.cabecalho { text-align: center; }

.logo {
    display: block;
    width: 110px;
    height: 110px;
    margin: 0 auto 15px;
    border-radius: 50%;
    object-fit: cover;
    border: 4px solid #bfdbfe;
}

h1 { color: #1d4ed8; font-size: 26px; margin: 0 0 6px; }
.subtitulo { color: #64748b; margin: 0 0 20px; }

.campo { margin-bottom: 14px; text-align: left; }
.campo label { display: block; font-weight: bold; margin-bottom: 6px; }
.campo input {
    width: 100%;
    padding: 10px;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    font-size: 15px;
}
.campo input:focus { outline: 2px solid #93c5fd; border-color: #2563eb; }

.linha-notas { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; align-items: end; }

.botoes { display: flex; flex-direction: column; gap: 10px; margin-top: 10px; }
button {
    padding: 12px;
    border: none;
    border-radius: 8px;
    color: white;
    font-weight: bold;
    cursor: pointer;
    transition: 0.2s;
}
button:hover { opacity: 0.85; transform: translateY(-1px); }
#btnMedia { background-color: #2563eb; }
#btnSituacao { background-color: #64748b; }
#btnLimpar { background-color: #0f766e; }

.erro { color: #dc2626; font-weight: bold; min-height: 20px; margin: 15px 0 0; }

.resultado {
    margin-top: 10px;
    padding: 15px;
    background-color: #f1f5f9;
    border-radius: 10px;
}
.resultado p { margin: 6px 0; }

.aprovado { color: #15803d; font-weight: bold; }
.reprovado { color: #dc2626; font-weight: bold; }

.link {
    display: block;
    margin-top: 20px;
    text-align: center;
    color: #1d4ed8;
}

.data-hora {
    margin-top: 15px;
    text-align: center;
    font-size: 14px;
    color: #64748b;
}

footer {
    margin-top: 20px;
    padding-top: 12px;
    border-top: 1px solid #e2e8f0;
    text-align: center;
    font-size: 12px;
    color: #64748b;
}

@media (max-width: 450px) {
    .container { padding: 25px 18px; }
    .linha-notas { grid-template-columns: 1fr; }
}
